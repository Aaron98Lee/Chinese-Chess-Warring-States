<Project Sdk="Microsoft.NET.Sdk">
  <!--
    NUnit tests for Xiangqi.Core. NUnit is also what the Unity Test Framework uses, so these
    tests avoid features newer than Unity's bundled NUnit where practical.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Xiangqi.Core/Xiangqi.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../data/*.json" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
